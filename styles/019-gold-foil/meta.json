{
  "schema": "hanzifx.style/1",
  "code": "019",
  "id": "gold-foil",
  "name": "烫金字",
  "nameEn": "Gold Foil",
  "aliases": ["烫金标题", "金字", "鎏金字", "春节金字", "金属字"],
  "kind": "style",
  "tags": ["春节", "喜庆", "国潮", "标题"],
  "status": "prototype",
  "version": "0.1.0",
  "tier": "open",
  "summary": "一两行烫金大标题：一道光带扫过把金字烫出来，停留时高光反复扫过，红底或透明底都能用。",
  "summaryEn": "A one- or two-line gold foil title: a band of light sweeps across and stamps the metal letters in, then glints keep running over them. Draws its own red ground or goes transparent.",
  "invoke": "用 019 把「2027 *新春快乐*」做成烫金字（日常默认 V1；要招牌效果说「招牌」或 look=showcase）",
  "invokeTemplate": "用 {code} 把「{text}」做成{name}，造型 {look}，配色 {palette}",
  "fitFor": ["春节、元宵、中秋的节日片头", "开业、周年庆、年会标题", "国潮品牌的金字标题"],
  "notFor": [
    { "case": "毛笔字墨迹晕开、要宣纸感的书法标题", "use": "003" },
    { "case": "一整段观点、要排满画面的大字", "use": "002" },
    { "case": "跟着口播走的字幕", "use": "004" }
  ],
  "platforms": [
    { "name": "抖音、视频号节庆片头", "basis": "inferred", "note": "没量过；书法标题那一轮量到的 3 条国庆片头里，金字红底最多" },
    { "name": "小红书节日封面", "basis": "inferred", "note": "没测" },
    { "name": "品牌开业和年会视频", "basis": "inferred", "note": "没测" }
  ],
  "sizes": ["1080x1920", "1920x1080", "1080x1080"],
  "fps": 30,
  "durationHint": "6 个字、节奏 R1：光带扫出约 1.1 秒，盖章 0.25 秒，停留 2.6 秒（V3 3.6 秒，期间高光再扫 2–3 次），出场 0.7 秒；V1 一共约 5 秒，V3 约 6.5 秒。实际时长看导出的 timeline.json",
  "timelineSegments": [
    { "name": "intro", "label": "入场（光带扫出、盖章）" },
    { "name": "hold", "label": "停留（高光扫过）" },
    { "name": "outro", "label": "出场" }
  ],
  "posterTime": "hold+0.15",
  "safeArea": { "bottom": 0.2, "right": 0.15, "measured": false, "note": "跟 002、003 同一组经验值，未实测；竖屏标题默认放在高度 0.42，避开底部 20%" },
  "requires": { "wordTimes": false, "beats": false, "tracking": false },
  "exportDefaults": { "bg": "studio" },
  "fonts": ["notoserif-black", "notosc-black", "mashanzheng", "zhimangxing"],
  "fontFallback": {
    "notoserif-black": ["notosc-black"],
    "notosc-black": [],
    "mashanzheng": ["notoserif-black"],
    "zhimangxing": ["notoserif-black"]
  },
  "extraGlyphs": "",
  "typography": { "writingMode": "horizontal", "lineBreak": "word", "maxLines": 3, "maxCharsPerLine": 8, "noOrphan": true, "punctCompress": true, "shrinkParticles": 1, "latinFont": null },
  "params": [
    { "key": "text", "type": "text", "label": "标题", "default": "2027 *新春快乐*", "maxLength": 24, "hint": "2–10 个字最好看。用 *关键词* 标出要最大、最亮的那几个字（关键词那一行单独放大，其余行做副标题）；回车换行；用 | 指定能断开的位置。不换行时自动按词断成一到两行" },
    { "key": "look", "type": "select", "label": "造型预设", "default": "V1", "options": [{ "value": "V1", "label": "V1 日常（默认）" }, { "value": "V3", "label": "V3 春节招牌" }], "hint": "V1＝日常默认（别名「日常」「daily」）：底色＋烫金标题＋高光扫两次；V3＝招牌（别名「招牌」「showcase」）：回纹和祥云暗纹、金粉飘落、金线边框、印章、闪光、慢慢推近" },
    { "key": "palette", "type": "select", "label": "配色", "default": "C1", "options": [{ "value": "C1", "label": "C1 经典红金" }, { "value": "C2", "label": "C2 黑金" }, { "value": "C3", "label": "C3 香槟金（藏青底）" }, { "value": "C4", "label": "C4 白底金" }, { "value": "C5", "label": "C5 朱砂亮金" }] },
    { "key": "rhythm", "type": "select", "label": "节奏", "default": "R1", "options": [{ "value": "R1", "label": "R1 标准" }, { "value": "R2", "label": "R2 慢（大气）" }, { "value": "R3", "label": "R3 快" }] },
    { "key": "font", "type": "select", "label": "字体", "default": "notoserif-black", "options": [{ "value": "notoserif-black", "label": "思源宋体 Black（默认，最稳）" }, { "value": "notosc-black", "label": "思源黑体 Black（粗黑体）" }, { "value": "mashanzheng", "label": "马善政楷书（毛笔楷书，喜庆）" }, { "value": "zhimangxing", "label": "钟齐志莽行书（行书，笔画细）" }] },
    { "key": "transparent", "type": "bool", "label": "透明底（不画底色，叠在视频上用）", "default": false, "hint": "导出时加 --bg transparent 也会自动切到透明底" },
    { "key": "seal", "type": "text", "label": "印章里的字", "default": "", "maxLength": 4, "allowEmpty": true, "hint": "1–4 个字，留空就不盖章（V3 默认「大吉」）" },
    { "key": "pattern", "type": "select", "label": "底上的暗纹", "default": "none", "options": [{ "value": "none", "label": "不要" }, { "value": "huiwen", "label": "回纹" }, { "value": "cloud", "label": "祥云" }, { "value": "both", "label": "回纹＋祥云" }], "hint": "透明底时不画" },
    { "key": "frame", "type": "bool", "label": "金线边框（四角回纹）", "default": false, "hint": "透明底时不画" },
    { "key": "dust", "type": "int", "label": "金粉数量", "default": 0, "min": 0, "max": 120, "hint": "透明底时金粉只在标题周围飘" },
    { "key": "ornament", "type": "bool", "label": "副标题两侧的金线和菱形", "default": false, "hint": "只在有关键词、分出了副标题行时画" },
    { "key": "glints", "type": "int", "label": "闪光星的数量（高光扫过时亮一下）", "default": 2, "min": 0, "max": 12 },
    { "key": "sweeps", "type": "int", "label": "停留时高光扫过几次", "default": 2, "min": 0, "max": 6, "hint": "两次之间至少隔 1 秒，停留时间不够就少扫几次" },
    { "key": "foil", "type": "range", "label": "金箔纹理强度", "default": 0.5, "min": 0, "max": 1, "step": 0.05 },
    { "key": "depth", "type": "range", "label": "金属厚度", "default": 1, "min": 0, "max": 2, "step": 0.05 },
    { "key": "edge", "type": "range", "label": "暗边粗细", "default": 1, "min": 0.4, "max": 1.6, "step": 0.05 },
    { "key": "glow", "type": "range", "label": "字后面的光晕", "default": 0.5, "min": 0, "max": 1, "step": 0.05, "hint": "透明底时不画" },
    { "key": "press", "type": "range", "label": "烫印力度（字被光带扫到时从大压回原大）", "default": 1, "min": 0, "max": 2, "step": 0.05 },
    { "key": "push", "type": "range", "label": "停留时慢慢推近", "default": 0, "min": 0, "max": 1, "step": 0.05, "hint": "1＝每秒放大 0.4%" },
    { "key": "sub", "type": "range", "label": "副标题行的大小（占关键词行的比例）", "default": 0.56, "min": 0.4, "max": 0.85, "step": 0.01 },
    { "key": "tracking", "type": "range", "label": "字距（占字号）", "default": 0, "min": -0.1, "max": 0.3, "step": 0.005 },
    { "key": "maxLines", "type": "int", "label": "最多几行", "default": 2, "min": 1, "max": 3 },
    { "key": "maxChars", "type": "int", "label": "一行最多几个字", "default": 8, "min": 3, "max": 10 },
    { "key": "size", "type": "number", "label": "字号上限（占画面短边；空着＝自动：竖屏和方形 0.22，横屏 0.28）", "default": null, "min": 0.08, "max": 0.4 },
    { "key": "sealSize", "type": "range", "label": "印章大小（占关键词行字号）", "default": 0.36, "min": 0.18, "max": 0.45, "step": 0.01 },
    { "key": "hold", "type": "number", "label": "停留秒数（空着＝按节奏，R1 是 2.6 秒）", "default": null, "min": 0.5, "max": 12 },
    { "key": "y", "type": "range", "label": "垂直位置（空着＝自动：竖屏 0.42，其他 0.47）", "default": null, "min": 0.15, "max": 0.85, "step": 0.01 },
    { "key": "seed", "type": "int", "label": "种子", "default": 19 }
  ],
  "palettes": [
    { "id": "C1", "name": "经典红金", "colors": { "fill": "#F0C259", "fill2": "#FFF5D1", "inner": "#A3621A", "outer": "#4A1405", "shadow": "#2A0204", "accent": "#EFC161", "bg": "#B3131B", "sub": "#7E0910" } },
    { "id": "C2", "name": "黑金", "colors": { "fill": "#E3B85E", "fill2": "#FFF2CB", "inner": "#86561A", "outer": "#1B1209", "shadow": "#000000", "accent": "#BE2A2B", "bg": "#0E0C0A", "sub": "#2C2318" } },
    { "id": "C3", "name": "香槟金（藏青底）", "colors": { "fill": "#E6D2A3", "fill2": "#FFFAEB", "inner": "#957A4A", "outer": "#0C1426", "shadow": "#040810", "accent": "#C0392E", "bg": "#13223F", "sub": "#1F335B" } },
    { "id": "C4", "name": "白底金", "colors": { "fill": "#DCA746", "fill2": "#FFF2C9", "inner": "#86540F", "outer": "#5C3A0B", "shadow": "#B8A07A", "accent": "#C8231E", "bg": "#F7F1E5", "sub": "#E6D8BD" } },
    { "id": "C5", "name": "朱砂亮金", "colors": { "fill": "#FFD25E", "fill2": "#FFFBE0", "inner": "#B86A12", "outer": "#5A1003", "shadow": "#3A0602", "accent": "#FFD976", "bg": "#D2261B", "sub": "#A3150F" } }
  ],
  "rhythms": [
    { "id": "R1", "name": "标准", "sweep": 1.0, "press": 0.4, "sheen": 0.85, "sealDur": 0.24, "hold": 2.6, "out": 0.7 },
    { "id": "R2", "name": "慢", "sweep": 1.45, "press": 0.55, "sheen": 1.15, "sealDur": 0.3, "hold": 3.4, "out": 0.9 },
    { "id": "R3", "name": "快", "sweep": 0.65, "press": 0.28, "sheen": 0.65, "sealDur": 0.18, "hold": 1.9, "out": 0.45 }
  ],
  "looks": [
    { "id": "V1", "name": "日常", "nameEn": "Everyday", "role": "default", "aliases": ["日常", "daily"], "params": { "seal": "", "pattern": "none", "frame": false, "ornament": false, "dust": 0, "glints": 2, "sweeps": 2, "foil": 0.5, "depth": 1, "glow": 0.5, "press": 1, "push": 0 } },
    { "id": "V3", "name": "春节招牌", "nameEn": "Lunar New Year", "role": "showcase", "aliases": ["招牌", "showcase", "春节"], "params": { "seal": "大吉", "pattern": "both", "frame": true, "ornament": true, "dust": 70, "glints": 7, "sweeps": 3, "foil": 0.7, "depth": 1.3, "glow": 0.8, "press": 1.3, "push": 1, "hold": 3.6, "sealSize": 0.42 } }
  ],
  "exports": ["mp4", "mov-alpha", "webm-alpha", "png-seq"],
  "checks": ["mid-word", "line-start-punct", "line-end-punct", "stroke-clip", "missing-glyph", "safe-area", "flash-rate", "seal-overlap"],
  "demo": {
    "default": { "look": "V1", "text": "2027 *新春快乐*", "video": "demo/019_V1_日常_竖屏.mp4", "gif": "demo/preview.gif", "poster": "demo/poster-v1.jpg" },
    "showcase": { "look": "V3", "text": "三羊开泰 *新春大吉*", "font": "mashanzheng", "video": "demo/019_V3_招牌_竖屏.mp4", "gif": "demo/showcase.gif", "poster": "demo/poster.jpg" }
  },
