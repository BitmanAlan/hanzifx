      }
    },
    {
      "id": "C4",
      "name": "绿紫",
      "colors": {
        "fill": "#E8FF45",
        "fill2": "#8CF53A",
        "inner": "#FFFFFF",
        "outer": "#160A2A",
        "shadow": "#7A2CFF",
        "accent": "#A852FF",
        "bg": "#2C1052",
        "sub": "#4A1E86"
      }
    }
  ],
  "rhythms": [
    {
      "id": "R1",
      "name": "标准",
      "gap": 0.42,
      "hold": 1.1
    },
    {
      "id": "R2",
      "name": "快（连击）",
      "gap": 0.28,
      "hold": 0.8
    },
    {
      "id": "R3",
      "name": "慢",
      "gap": 0.65,
      "hold": 1.5
    }
  ],
  "looks": [
    {
      "id": "V1",
      "name": "日常",
      "nameEn": "Everyday",
      "role": "default",
      "aliases": [
        "日常",
        "daily"
      ],
      "params": {
        "flair": 0,
        "ring": false,
        "rays": 0.35,
        "debris": 0,
        "shake": 0.6,
        "depth": 0.55,
        "persp": 0.6
      }
    },
    {
      "id": "V3",
      "name": "招牌",
      "nameEn": "Signature",
      "role": "showcase",
      "aliases": [
        "招牌",
        "showcase"
      ],
      "params": {
        "flair": 1,
        "ring": true,
        "rays": 1,
        "debris": 14,
        "shake": 1.1,
        "depth": 0.9,
        "persp": 0.9,
        "tilt": 11
      }
    }
  ],
  "exports": [
    "mov-alpha",
    "webm-alpha",
    "png-seq",
    "mp4"
  ],
  "checks": [
    "mid-word",
    "line-start-punct",
    "stroke-clip",
    "missing-glyph",
    "safe-area",
    "flash-rate",
    "brand-lookalike"
  ],
  "demo": {
    "default": {
      "look": "V1",
      "text": "哐！",
      "video": "demo/017_V1_日常_竖屏.mp4",
      "gif": "demo/preview.gif",
      "poster": "demo/poster-v1.jpg",
      "posterTime": "intro.end-0.16"
    },
    "showcase": {
      "look": "V3",
      "text": "哐！|咚！|啪！",
