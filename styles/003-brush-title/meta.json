    }
  ],
  "license": {
    "code": "MIT",
    "doc": "CC-BY-NC-4.0",
    "demo": "CC-BY-4.0"
  },
  "measuredDefaults": {
    "source": "国庆片头实测（2026-11-19，3 条成片）",
    "lineWidth": "4 个字横排占画面宽 79%–80%",
    "y_vertical": 0.4
  },
  "platforms": [
    {
      "name": "抖音节庆片头",
      "basis": "measured",
      "note": "第一轮量到 3 条国庆片头成片，金字红底最多"
    },
    {
      "name": "视频号节庆片头",
      "basis": "inferred",
      "note": "没测"
    },
    {
      "name": "小红书封面",
      "basis": "inferred",
      "note": "没测"
    }
  ]
}
